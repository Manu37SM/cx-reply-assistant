# Neon Postgres connection string.
# Get this from your Neon project dashboard -> Connection Details.
# Use the "pooled" connection string for serverless/edge deployments.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model used for reply generation.
# Defaults to anthropic/claude-3.5-haiku if not set.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
